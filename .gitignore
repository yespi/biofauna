# No secrets
*.key
*.pem
*.env
.api-keys
*secret*
*token*

# No large model files (except prototype centroids in data/patterns/)
*.pt
*.bin
*.pth
*.ckpt
*.h5
*.safetensors

# Exception: prototype centroids (small, essential for model)
!data/patterns/**/*.npy

# No production paths
/mnt/
*.log
tmp/
temp/
